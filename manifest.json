{
  "manifest_version": 3,
  "name": "ShieldBlock - Ad & Tracker Blocker",
  "version": "1.0.0",
  "description": "High-performance ad blocker, tracker shield, popup defender, and cosmetic element hider.",
  "author": "Corey Kiesel",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_rules",
        "enabled": true,
        "path": "rules/ads_rules.json"
      },
      {
        "id": "privacy_rules",
        "enabled": true,
        "path": "rules/privacy_rules.json"
      },
      {
        "id": "annoyances_rules",
        "enabled": true,
        "path": "rules/annoyances_rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/cosmetic.css"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options/options.html"
}
